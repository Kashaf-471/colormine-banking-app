<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Calling -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- SMS -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Location (GPS) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- WiFi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Biometric -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ColorMineApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColorMineBank"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Splash -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ColorMineBank.Splash"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Flow -->
        <activity android:name=".OnboardingActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".LoginSignupActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".ForgotPasswordActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".VerifyOtpActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".ResetPasswordActivity"
            android:screenOrientation="portrait" android:exported="false"/>

        <!-- Main App -->
        <activity android:name=".MainActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".CardDetailActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".CardStatisticActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".SendMoneyActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".TransferSuccessActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".RequestMoneyActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".RequestSuccessActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".NotificationsActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".AdminActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".AdminTransactionsActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".UserDetailsActivity"
            android:screenOrientation="portrait" android:exported="false"/>

        <!-- Account & Settings -->
        <activity android:name=".AccountActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".PersonalInfoActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".EditProfileActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".SecurityActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".SettingsActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".HelpActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".TermsActivity"
            android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".CameraActivity"
            android:screenOrientation="portrait" android:exported="false"/>

        <!-- Background Service -->
        <service
            android:name=".services.SyncService"
            android:enabled="true"
            android:exported="false" />

        <!-- Broadcast Receiver -->
        <receiver
            android:name=".receivers.NetworkChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.BluetoothReceiver"
            android:exported="false" />

    </application>
</manifest>
