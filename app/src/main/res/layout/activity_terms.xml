<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">
        <ImageButton android:id="@+id/btn_back"
            android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn_white"
            android:src="@drawable/ic_arrow_left"
            android:padding="10dp"
            android:contentDescription="Back"
            android:layout_centerVertical="true"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/poppins_semibold"
            android:text="Terms &amp; Conditions"
            android:textColor="@color/colorTextPrimary"
            android:textSize="18sp"/>
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="@dimen/screen_padding"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/colorSurface">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="1. Introduction"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Welcome to ColorMine Bank. By using our application, you agree to these terms and conditions in full. If you disagree with any part of these terms, you must not use this application."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="2. Account Security"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="You are responsible for maintaining the confidentiality of your login credentials, including your password, PIN, and OTP. ColorMine Bank will never ask for your password via email or phone."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="3. Transactions"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="All transactions are final. Please double-check recipient details before confirming any transfer. The 'Freeze Account' feature is provided for your protection to temporarily disable outgoing funds."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="4. Privacy"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Your data is stored securely in our cloud database. We use your information only to provide banking services and to improve your experience."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Last updated: May 04, 2026"
                    android:textColor="@color/colorTextHint"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="20dp"/>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</LinearLayout>
