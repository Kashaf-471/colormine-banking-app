<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_btn_white"
                android:src="@drawable/ic_arrow_left"
                android:padding="10dp"
                android:contentDescription="Back"
                android:layout_centerVertical="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="Add New Card"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"/>
        </RelativeLayout>

        <!-- Card Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gradient"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginBottom="32dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_credit_card"
                    app:tint="@color/colorTextWhite" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_trending_up"
                    app:tint="@color/colorTextWhite" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_preview_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.15"
                android:text="XXXX  XXXX  XXXX  XXXX"
                android:textColor="@color/colorTextWhite"
                android:textSize="20sp"
                android:layout_marginBottom="24dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cardholder Name"
                        android:textColor="#DDD6FE"
                        android:textSize="10sp"/>
                    <TextView
                        android:id="@+id/tv_preview_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="FULL NAME"
                        android:textColor="@color/colorTextWhite"
                        android:textSize="13sp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expiry Date"
                        android:textColor="#DDD6FE"
                        android:textSize="10sp"/>
                    <TextView
                        android:id="@+id/tv_preview_expiry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="MM/YY"
                        android:textColor="@color/colorTextWhite"
                        android:textSize="13sp"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- Form -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cardholder Name"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:id="@+id/et_cardholder_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edittext"
            android:drawableStart="@drawable/ic_user"
            android:drawablePadding="12dp"
            android:hint="Tanya Myroniuk"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiry Date"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/et_expiry_date"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="MM/YY"
                    android:inputType="date"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVV"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/et_cvv"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="***"
                    android:inputType="numberPassword"
                    android:maxLength="3"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Card Number"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:id="@+id/et_card_number"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edittext"
            android:drawableStart="@drawable/ic_credit_card"
            android:drawablePadding="12dp"
            android:hint="4562 1122 4595 7852"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Transaction PIN (4 digits)"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:id="@+id/et_card_pin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edittext"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="12dp"
            android:hint="****"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btn_save_card"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="@font/poppins_semibold"
            android:text="Add Card"
            android:textAllCaps="false"
            android:textColor="@color/colorTextWhite"
            android:textSize="16sp"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>
